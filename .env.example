# Server
SERVER_PORT=8083
DATABASE_URL=postgres://appraisal:appraisal@localhost:5434/notification_db?sslmode=disable
ALLOWED_ORIGINS=*

# Redis & Dedup
REDIS_ADDR=localhost:6381
REDIS_PASSWORD=appraisal
DEDUP_TTL=24h

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_CONSUMER_GROUP=notification-service
KAFKA_REQUEST_TOPIC=request.events
KAFKA_INSPECT_TOPIC=inspect.events
KAFKA_REVIEW_TOPIC=review.events

# SMTP (Mailpit locally: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@appraisal-crm.ru
SMTP_ENABLED=true

# Auth & Frontend URLs
JWKS_URL=http://localhost:8180/realms/appraisal/protocol/openid-connect/certs
CLIENT_PORTAL_URL=http://localhost:5173
OFFICE_PORTAL_URL=http://localhost:5174

